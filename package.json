{
  "name": "react-observatory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run runtime && concurrently -k -n web,render \"vite --host 127.0.0.1 --port 5174\" \"tsx watch server/index.ts\"",
    "runtime": "node scripts/build-runtime.mjs",
    "build": "npm run runtime && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio src/video/index.ts",
    "render:all": "tsx scripts/render-all.ts",
    "render:demo": "tsx scripts/render-all.ts --demo",
    "build:demo": "node scripts/build-demo.mjs",
    "prepare:labs": "tsx scripts/prepare-labs.ts",
    "format:check": "prettier --check src server scripts tests vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "^7.9.0",
    "remotion": "4.0.356",
    "@remotion/player": "4.0.356",
    "@remotion/renderer": "4.0.356",
    "@remotion/bundler": "4.0.356",
    "@remotion/cli": "4.0.356",
    "@babel/standalone": "^7.28.4",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/view": "^6.38.0",
    "@codemirror/state": "^6.5.2",
    "codemirror": "^6.0.2",
    "@fontsource-variable/onest": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "express": "^5.1.0",
    "zod": "^4.0.0",
    "lucide-react": "^0.468.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "tsx": "^4.20.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/babel__standalone": "^7.1.9",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.6.2"
  }
}
