  "source": "import { useState } from 'react';\nimport { trace, useSnapshot } from '@observatory/lab';\n\nconst initial = [\n  { id: 'a', title: 'Дизайн' },\n  { id: 'b', title: 'Разработка' },\n  { id: 'c', title: 'Проверка' },\n];\nfunction Row({ item }) {\n  const [value, setValue] = useState(item.title);\n  useSnapshot('Row:' + item.id, {\n    id: item.id,\n    value,\n    title: item.title,\n  });\n  return (\n    <label className=\"task-row\">\n      <span>{item.id}</span>\n      <input\n        aria-label={'Задача ' + item.id}\n        value={value}\n        onChange={(e) => {\n          trace.action('Редактирование', {\n            id: item.id,\n            value: e.target.value,\n          });\n          setValue(e.target.value);\n        }}\n      />\n    </label>\n  );\n}\nexport default function App() {\n  const [items, setItems] = useState(initial);\n  return (\n    <section>\n      <span className=\"eyebrow\">Идентичность</span>\n      <h2>План проекта</h2>\n      <p>Измените первую задачу и переверните список.</p>\n      {items.map((item, index) => (\n        <Row key={item.id} item={item} />\n      ))}\n      <button\n        onClick={() => {\n          trace.action('Перевернуть');\n          setItems((items) => [...items].reverse());\n        }}\n      >\n        Перевернуть список\n      </button>\n    </section>\n  );\n}\n",
